# Database (required for persistent trips, incidents, and RFID scans)
# Example: mysql://root:password@127.0.0.1:3306/rasd
DATABASE_URL=

# Session and Manus OAuth
JWT_SECRET=
VITE_APP_ID=
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://auth.manus.im
OWNER_OPEN_ID=
OWNER_NAME=RSD Owner

# Manus built-in APIs and object storage (server-side only)
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=

# Optional frontend built-in API access, only if a feature needs it
VITE_FRONTEND_FORGE_API_URL=https://forge.manus.im
VITE_FRONTEND_FORGE_API_KEY=

# RFID USB bridge (server-side only)
RSD_BRIDGE_API_KEY=

# Daily dashboard and data retention
# Days to keep detections, incidents and trips before automatic deletion (default 30)
RSD_RETENTION_DAYS=30
# Dashboard day boundary as a UTC offset in hours (Riyadh = 3)
RSD_DAY_UTC_OFFSET_HOURS=3
# Ignore a second tap of the same card within this many ms of entry (default 5000)
RSD_RESCAN_GUARD_MS=5000
